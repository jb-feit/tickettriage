# Copy to .env and edit. Never commit .env.

# --- Dataset ---------------------------------------------------------------
DATASET_NAME=bitext/Bitext-customer-support-llm-chatbot-training-dataset
TEXT_COL=instruction
LABEL_COL=intent
LAUNCH_FRACTION=0.75
SEED=42

# --- Embeddings ------------------------------------------------------------
# local   = sentence-transformers on CPU (free, works before Bedrock access)
# bedrock = Amazon Titan Text Embeddings V2
# Pick ONE and keep it: vectors from different models must never be mixed.
# If you switch backend later, re-run `make embed` (it writes to a separate folder).
EMBEDDING_BACKEND=local
LOCAL_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
BEDROCK_EMBED_MODEL_ID=amazon.titan-embed-text-v2:0
BEDROCK_EMBED_DIMS=512

# --- AWS -------------------------------------------------------------------
AWS_REGION=eu-central-1
# Optional: a Claude model id/inference profile available in YOUR region, used only by
# `python -m tickettriage.check_bedrock --judge` to confirm LLM access early.
BEDROCK_JUDGE_MODEL_ID=

# --- Local Postgres (docker compose) -----------------------------------------
POSTGRES_USER=tickettriage
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=tickettriage
